// dsl/std/cross_arch.dag — cross-architecture execution surface (gunbos)
//
// Models the translation layer between two DeploymentTargets as a pure projection
// over their SyscallAbi data rows. No hardcoded arch cases — OMNI INVARIANT: adding
// a new OS/ABI is one new extdep data row, cost-of-change = 1.
//
// Two paths compose:
//   §1  generate_cross_arch_surface(host, guest) — pure fold/join over SyscallAbi tables;
//       the .dag fold IS the translation layer, no external translator code needed
//       for the declaration layer.
//   §2  KnownTranslator + ValidatedCrossArchRoute — optionally bind a cited runtime
//       translator extdep (FEX-ELF, QEMU user-mode, Rosetta 2) to a generated surface.
//
// §3  ExecutionRoute — dispatch token for the satisfies kernel (native or translated).
//     When satisfies() lands (P-CF-WITNESS, compute_fabric.dag), route this through
//     the shared Realization carrier — do NOT hand-roll a separate witness.
//
// List discipline: authored against abstract List<T> ops only —
//   fold_list, Cons, Empty (and filter/contains/length when needed).
//   Do NOT use flat_map, |> pipe, or any concrete-carrier method.
//
// 🟡 consumer:abstract-list-carrier — fold_list/Cons/Empty resolve when abstract
//    List<T> carrier lands (escalate carrier Qs to snappy-stag-903).
// 🟡 consumer:gunbc-architecture-profile — DeploymentTarget, SyscallAbi, SyscallEntry,
//    and CallingConvention resolve when gunbc #4882 (sharp-lark-26) merges and ctrl
//    receives the snappy-stag-verified combined go-signal (PIN-HOLD in effect;
//    flip-SHA alone is NOT go).
//    .invocation field on DeploymentTarget resolves in Slice-2 (StableInvocationSurface).
// 🟡 consumer:dsl-rooted-claim-run-gate — same corpus gate as std.target.
//
// v2-green: record/if-else/fold_list; no named-Option import needed.

module std.cross_arch

import std.architecture_profile { DeploymentTarget, CallingConvention, SyscallAbi, SyscallEntry }
// 🟡 consumer:abstract-list-carrier — fold_list/Cons/Empty from abstract List carrier.
import std.list { fold_list, Cons, Empty }
import std.types { NonEmptyStr, Bool, Int }

// --- §1 generated translation surface ----------------------------------------

// A single syscall remapping: same-named entry, different number per OS/arch.
// Generated by joining the two SyscallAbi tables via fold_list on entry name.
type SyscallRemapping {
  name:         NonEmptyStr
  guest_number: Int
  host_number:  Int
}

// The two CallingConventions side by side. The calling-convention delta is a structural
// diff over these two records (arg0..arg5, syscall_number, return_value). Consumers
// read individual fields; we do not pre-expand into per-role pairs here.
type ConventionPair {
  guest: CallingConvention
  host:  CallingConvention
}

// The full cross-arch translation surface: generated entirely from two DeploymentTarget
// rows via fold/join. No switch-on-arch, no hardcoded table. A runtime translator
// that consumes this record has everything it needs to remap any syscall invocation.
type CrossArchSurface {
  host:            DeploymentTarget
  guest:           DeploymentTarget
  syscall_map:     List<SyscallRemapping>
  convention_pair: ConventionPair
}

// Join guest and host syscall tables on entry name to produce the remapping list.
// Uses only abstract List ops (fold_list/Cons/Empty). Result order is unspecified
// (fold builds in reverse); consumers must not rely on ordering.
// 🟡 consumer:invocation-field — .table field available when gunbc #4882 merges.
// 🟡 consumer:abstract-list-carrier — fold_list/Cons/Empty (see module header).
fn generate_syscall_map(guest_abi: SyscallAbi, host_abi: SyscallAbi) -> List<SyscallRemapping> {
  fold_list(
    guest_abi.table,
    Empty,
    (acc, g) =>
      fold_list(
        host_abi.table,
        acc,
        (acc2, h) =>
          if g.name == h.name {
            Cons(SyscallRemapping { name: g.name, guest_number: g.number, host_number: h.number }, acc2)
          } else {
            acc2
          }
      )
  )
}

// Core generator: projects the full translation surface from any two DeploymentTargets.
// The .dag fold IS the translation layer — no external lookup table needed.
// 🟡 consumer:invocation-field — .invocation/.convention fields (gunbc #4882 gate).
// 🟡 consumer:abstract-list-carrier — see generate_syscall_map.
fn generate_cross_arch_surface(host: DeploymentTarget, guest: DeploymentTarget) -> CrossArchSurface {
  CrossArchSurface {
    host: host,
    guest: guest,
    syscall_map: generate_syscall_map(guest.invocation, host.invocation),
    convention_pair: ConventionPair {
      guest: guest.invocation.convention,
      host:  host.invocation.convention,
    },
  }
}

// --- §2 known translator extdeps (composable, not required) ------------------

// A cited binary translator that implements a CrossArchSurface at runtime.
// Data rows live in dsl/extdeps/translators/ (FEX-ELF, QEMU user-mode, Rosetta 2…).
// full_coverage: true = translator covers any guest within its supported arch family.
type KnownTranslator {
  name:          NonEmptyStr
  citation:      NonEmptyStr
  full_coverage: Bool
}

// A cross-arch route with a cited translator bound to the generated surface.
// Compose with generate_cross_arch_surface for the full declaration.
type ValidatedCrossArchRoute {
  surface:    CrossArchSurface
  translator: KnownTranslator
}

// --- §3 execution route -------------------------------------------------------

type ExecutionRoute
  = NativeExecution    { host: DeploymentTarget }
  | TranslatedExecution { route: ValidatedCrossArchRoute }
